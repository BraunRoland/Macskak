<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Játékok</title>
    <link rel="stylesheet" href="jatekok.css">
</head>
<body>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Név</th>
            </tr>
        </thead>
        <tbody>
            <% toys.forEach(toy => { %>
                <tr>
                    <td><%= toy.id %></td>
                    <td><%= toy.nev %></td>
                    <td>
                        <form method="post">
                            <input type="text" name="id" value="<% toy.id %>" hidden>
                            <input type="text" name ="nev" value="<% toy.nev %>" hidden>
                            <button type="submit" class="deleteBtn">Törlés</button>
                        </form>
                    </td>
                    <td>
                        <form action="">
                            
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>