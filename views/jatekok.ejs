<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Játékok</title>
</head>
<body>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Név</th>
            </tr>
        </thead>
        <tbody>
            <% toys.forEach(toy => { %>
                <tr>
                    <td><%= toy.id %></td>
                    <td><%= toy.nev %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>