<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Új Játék</title>
</head>
<body>
    <form method="post">
        <label for="nev">Játék neve</label> <br>
        <input type="text" name="nev"> <br> <br>
        <button type="submit">Beküldés</button>
    </form>
    <% if (typeof siker != 'undefined') { %>
        <% if (siker) { %>
            <p>Sikeres Hozzáadás! ID: <%= p.id %> Név: <%= p.nev %></p>
        <% } else { %>
            <p>Hiba! <%= p %></p>
        <% } %>
    <% } %>
</body>
</html>