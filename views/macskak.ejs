<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Macskák</title>
</head>
<body>
    <table>
        <thead>
            <tr>
                <th>id</th>
                <th>Súly</th>
                <th>Szem szín</th>
                <th>Gazdi id</th>
                <th>Játék id</th>
            </tr>
        </thead>
        <tbody>
             <% cats.forEach(cat => { %>
                <tr>
                    <td><%= cat.id %></td>
                    <td><%= cat.suly %></td>
                    <td><%= cat.szem_szin %></td>
                    <td><%= cat.gazdi_id %></td>
                    <td><%=
                        cat.jatek_id?
                        cat.jatek_id
                        :
                        "Nincs"  
                    %></td>
                </tr>
             <% }); %>
        </tbody>
    </table>
</body>
</html>